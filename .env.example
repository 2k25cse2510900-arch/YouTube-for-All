# ==============================================================================
# A Lesson With AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# NEVER commit your real .env file or OAuth tokens to source control!
# ==============================================================================

# --- YouTube OAuth Paths ---
GOOGLE_CLIENT_SECRETS_FILE=secrets/client_secret.json
GOOGLE_TOKEN_FILE=token.json

# --- Publishing & Automation Safeguards ---
# Set to 'true' to require manual human approval before any video is published
REQUIRE_HUMAN_APPROVAL=true

# Schedule interval in hours (default: 24 hours for daily Shorts)
PUBLISH_INTERVAL_HOURS=24

# Default target time of day to schedule Shorts (24-hour HH:MM format, e.g., 18:00)
DEFAULT_PUBLISH_TIME=18:00

# YouTube Default Privacy: private, unlisted, or public
YOUTUBE_DEFAULT_PRIVACY_STATUS=private

# --- Video Specifications (Vertical 9:16 Shorts) ---
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# --- Logging & Debugging ---
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log

# --- Google Gemini AI Research Settings ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3

# --- Audio & Voice Provider (Strict ₹0 Budget: edge_tts) ---
AUDIO_VOICE_PROVIDER=edge_tts
AUDIO_DEFAULT_VOICE=hi-IN-MadhurNeural
AUDIO_FALLBACK_VOICE=hi-IN-SwaraNeural
# SARVAM_API_KEY=

# --- Image Generation Provider (Strict ₹0 Budget: mock_pillow) ---
IMAGE_PROVIDER=mock_pillow
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# --- Quality Checker & Video Settings ---
VIDEO_ENCODING_PRESET=veryfast
VIDEO_CRF=23
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
